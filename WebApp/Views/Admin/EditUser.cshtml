@using static WebApp.ViewModels.AdminViewModel
@model WebApp.ViewModels.AdminViewModel

<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow">

    <h4 class="text-xl font-semibold mb-4 text-gray-900">Edit user</h4>
    <hr class="mb-6">

    <form asp-action="EditUser" class="space-y-4">

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <div>
            <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="UserName"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="UserName" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Password" type="password"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Password" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="ConfirmPassword" type="password"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Email" type="email"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Email" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Role" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="Role"
                    class="w-full rounded-md border border-gray-300 px-3 py-2
                           focus:outline-none focus:ring-2 focus:ring-blue-500"
                    asp-items="Html.GetEnumSelectList<RoleType>()">
            </select>
        </div>

        <div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 rounded-md font-medium
                           hover:bg-blue-700 transition">
                Save
            </button>
        </div>

    </form>

    <p class="mt-4 text-sm text-gray-600 text-center">
        <a asp-action="AdminPanel" class="text-blue-600 hover:text-blue-800 font-medium">
            Back to users list
        </a>
    </p>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
