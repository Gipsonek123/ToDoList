@model WebApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="max-w-md mx-auto mt-12 bg-white p-6 rounded-lg shadow">

    <h1 class="text-2xl font-semibold mb-6 text-center">
        Login
    </h1>

    <form asp-action="Login" class="space-y-4">

        <div asp-validation-summary="ModelOnly"
             class="text-sm text-red-600"></div>

        <div>
            <label asp-for="Username"
                   class="block text-sm font-medium text-gray-700 mb-1"></label>

            <input asp-for="Username"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />

            <span asp-validation-for="Username"
                  class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Password"
                   class="block text-sm font-medium text-gray-700 mb-1"></label>

            <input asp-for="Password"
                   type="password"
                   class="w-full rounded-md border border-gray-300 px-3 py-2
                          focus:outline-none focus:ring-2 focus:ring-blue-500" />

            <span asp-validation-for="Password"
                  class="text-sm text-red-600"></span>
        </div>

        <div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 rounded-md
                           font-medium hover:bg-blue-700 transition">
                Login
            </button>
        </div>
    </form>

    <p class="mt-4 text-center text-sm text-gray-600">
        Don't have an account?
        <a asp-action="Register"
           data-ajax-link
           class="text-blue-600 hover:text-blue-800 font-medium">
            Register
        </a>
    </p>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
