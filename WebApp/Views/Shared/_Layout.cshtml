<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-800">

    <header class="bg-white border-b shadow-sm">
        <nav class="w-full px-4">
            <div class="flex h-16 items-center justify-between">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-xl font-semibold text-gray-900">
                   WebApp
                </a>

                <div class="ml-auto flex items-center space-x-6">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="text-gray-700 hover:text-blue-600 font-medium">
                       Home
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy"
                       class="text-gray-700 hover:text-blue-600 font-medium">
                       Privacy
                    </a>

                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 py-6">
        @RenderBody()
    </main>

    <footer class="border-t bg-white text-sm text-gray-500">
        <div class="w-full mx-auto px-4 py-4 flex justify-between">
            <span>&copy; 2025 - WebApp</span>
            <a asp-controller="Home"
               asp-action="Privacy"
               class="hover:text-blue-600">
                Privacy
            </a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
