<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-800">

    <header class="bg-white border-b shadow-sm">
        <nav class="w-full px-4">
            <div class="flex h-16 items-center justify-end">
                    @await Html.PartialAsync("_LoginPartial")
            </div>
        </nav>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 py-6">
        <div id="page-content">
            @RenderBody()
        </div>
    </main>

    <footer class="border-t bg-white text-sm text-gray-500">
        <div class="w-full mx-auto px-4 py-4 flex justify-normal">
            <span>&copy; 2025 - WebApp</span>
        </div>
    </footer>


    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
